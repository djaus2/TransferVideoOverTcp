<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net9.0-android;</TargetFrameworks>
		<OutputType>Exe</OutputType>
		<RootNamespace>SendVideo</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
    <PackageLicenseExpression>CC-BY-SA-4.0</PackageLicenseExpression>
    <NoWarn>$(NoWarn);XC0022</NoWarn>
	</PropertyGroup>
	
	<!-- Debug configuration -->
	<PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
		<RuntimeIdentifiers>android-arm64</RuntimeIdentifiers>
		<AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
	</PropertyGroup>
	
	<!-- Release configuration -->
	<PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
		<RuntimeIdentifiers>android-arm64</RuntimeIdentifiers>
		<AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
		<AndroidLinkMode>None</AndroidLinkMode>
		<AndroidUseSharedRuntime>false</AndroidUseSharedRuntime>
		<RunAOTCompilation>false</RunAOTCompilation>
		<AndroidEnableSGenConcurrent>false</AndroidEnableSGenConcurrent>
	</PropertyGroup>

	<PropertyGroup>
		<!-- Display name -->
		<ApplicationTitle>SendVideo</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>sportronics.sendvideo</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
		<WindowsPackageType>None</WindowsPackageType>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />

		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="9.0.0" />
		<PackageReference Include="Sportronics.SendVideoOverTcpLib" Version="2.0.2" />
    <!-- ProjectReference Include="..\VideoEnums\VideoEnums.csproj" / -->
	</ItemGroup>

	<ItemGroup>
   
	</ItemGroup>

	<ItemGroup>
	  <Compile Update="MainPage.xaml.cs">
	    <DependentUpon>MainPage.xaml</DependentUpon>
	  </Compile>
	</ItemGroup>

</Project>
